# Copy to .env — never commit .env

# Supabase (required for collector DB examples)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SEC EDGAR (required for sec_edgar collector)
# Format: "Your Name your@email.com"
SEC_USER_AGENT=

# Optional: S3-compatible storage for raw artifacts
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=

# Rate limit seconds between SEC requests (default 0.15)
SEC_API_DELAY=0.15
